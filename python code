"""Minimal backend for an AI app.

Run with: python "c:\\Users\\joaqu\\Documents\\python code"
Then POST JSON such as {"message": "Hello"} to /chat.
"""

from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from urllib.parse import urlparse
import re


HOST = os.getenv("HOST", "127.0.0.1")
PORT = int(os.getenv("PORT", "8000"))

STOP_WORDS = {
	"about", "after", "again", "also", "been", "being", "could", "does",
	"from", "have", "into", "just", "more", "most", "that", "their",
	"them", "there", "these", "they", "this", "what", "when", "where",
	"which", "with", "would", "your",
}


def question_terms(text):
	return {
		word for word in re.findall(r"[a-z0-9]{3,}", text.lower())
		if word not in STOP_WORDS
	}


def relevant_answer(question, answer):
	"""Reject a response that does not address any meaningful part of the question."""
	terms = question_terms(question)
	matches = terms.intersection(question_terms(answer))
	required_matches = min(2, len(terms))
	return bool(terms) and len(matches) >= required_matches


class APIHandler(BaseHTTPRequestHandler):
	def _send_json(self, status, payload):
		body = json.dumps(payload).encode("utf-8")
		self.send_response(status)
		self.send_header("Content-Type", "application/json; charset=utf-8")
		self.send_header("Content-Length", str(len(body)))
		self.send_header("Access-Control-Allow-Origin", "*")
		self.end_headers()
		self.wfile.write(body)

	def do_OPTIONS(self):
		self.send_response(204)
		self.send_header("Access-Control-Allow-Origin", "*")
		self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
		self.send_header("Access-Control-Allow-Headers", "Content-Type")
		self.end_headers()

	def do_GET(self):
		if urlparse(self.path).path == "/health":
			self._send_json(200, {"status": "ok"})
		else:
			self._send_json(404, {"error": "Not found"})

	def do_POST(self):
		if urlparse(self.path).path != "/chat":
			self._send_json(404, {"error": "Not found"})
			return

		try:
			length = int(self.headers.get("Content-Length", 0))
			data = json.loads(self.rfile.read(length))
			message = data.get("message", "")
		except (ValueError, json.JSONDecodeError):
			self._send_json(400, {"error": "Request must contain valid JSON"})
			return

		if not isinstance(message, str) or not message.strip():
			self._send_json(400, {"error": "message must be a non-empty string"})
			return

		question = message.strip()
		reply = f"I understood your question about: {question}"
		if not relevant_answer(question, reply):
			self._send_json(422, {"error": "The generated answer did not match the question."})
			return
		self._send_json(200, {
			"reply": reply,
			"relevant": True,
			"rule": "Answer only when the response shares meaningful terms with the question.",
		})

	def log_message(self, *_):
		pass


if __name__ == "__main__":
	server = ThreadingHTTPServer((HOST, PORT), APIHandler)
	print(f"AI backend running at http://{HOST}:{PORT}")
	try:
		server.serve_forever()
	except KeyboardInterrupt:
		pass
	finally:
		server.server_close()
